# ---- Database (SQLite by default) ----
DATABASE_URL="file:./dev.db"

# ---- Anthropic (Claude) ----
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for scoring + heading generation. Opus 4.8 is the default (highest quality).
# For high-volume/cheaper scoring you can set this to claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL="claude-opus-4-8"

# ---- X (Twitter) API — Basic tier or higher ----
# From your app in https://developer.x.com/  (Keys and tokens tab)
# OAuth 1.0a user context is required for posting AND media upload.
X_APP_KEY="your-api-key"
X_APP_SECRET="your-api-secret"
X_ACCESS_TOKEN="your-access-token"
X_ACCESS_SECRET="your-access-token-secret"

# ---- Cron protection ----
# Any random string. The /api/cron/run endpoint requires ?key=<this> (or Bearer header).
CRON_SECRET="change-me-to-a-long-random-string"
